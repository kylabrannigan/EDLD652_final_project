theme_set(theme_minimal(base_family = "Quicksand"))
car_rates_plot_final <- car_rates %>%
ggplot(aes(x = mean_walk, y = car))+
geom_point(aes(color = City)) +
geom_smooth(method ="lm", color = "black", fill = "pink")+
theme_minimal()+
labs(title = "Relationship between walkability and number of households
that own at least 1 car",
x= "Walkability",
y = "Number of Households wiith > 1 car")+
theme(text = element_text(family = "Quicksand"))
