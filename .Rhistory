#
# write.csv(walkability, "Walkability.csv")
crash <- import(here("data", "FARS2019NationalCSV", "accident.csv")) #crash data
walkability <- import(here("data", "Walkability.csv")) #cleaned walkability data
OR_walkability<- import(here("data", "OR_walkability.csv")) #Oregon-specific walkability
city_walkability <- walkability %>% #walkability for each city
group_by(City) %>%
summarise(mean_walk = mean(NatWalkInd))
# Crash Data Filtering
crash <- crash %>%
select(STATENAME, RUR_URBNAME, HARM_EVNAME, FATALS)
### Initial plan: Map with color gradient showing concentration of walkable cities
# I can't get this to work right now so I'm pivoting a bit, but I will try again later (I really want to display a map)
# # library-ing packages needed for mapping
# library(tigris)
# library(sf)
# # Load walkability data
# walk <- OR_walkability
#   mutate(GEOID10 = formatC(as.numeric(GEOID10), format = "fg", flag = "0") |>
#            str_pad(width = 12, side = "left", pad = "0"))
#
# # Get Oregon block group geometries
# or_bg <- block_groups(state = "OR", year = 2019, cb = TRUE)
#
# # Join walkability data to block group geometries
# or_bg_walk <- or_bg |>
#   left_join(walk, by = c("GEOID" = "GEOID10"))
#
# # Plot
# ggplot(or_bg_walk) +
#   geom_sf(aes(fill = NatWalkInd), color = NA) +
#   scale_fill_viridis_c(
#     name = "Walkability\nIndex",
#     option = "plasma",
#     na.value = "grey80"
#   ) +
#   labs(
#     title = "Oregon Walkability by Block Group",
#     subtitle = "National Walkability Index (EPA Smart Location Database)",
#     caption = "Source: EPA Smart Location Database"
#   ) +
#   theme_void() +
#   theme(legend.position = "right")
# looking at concentration of low, med, and high wage workers and walkability
# adding the pre-defined categories for walkability to make it more interpretable rather than the continuous scale
wage_walkability <- walkability |>
filter(!is.na(NatWalkInd), !is.na(E_LowWageWk), !is.na(E_MedWageWk), !is.na(E_HiWageWk)) |>
mutate(WalkCat = cut(NatWalkInd,
breaks = c(0, 5.75, 10.5, 15.25, 20),
labels = c("Least\nWalkable\n(1–5.75)", "Below Avg\n(5.75–10.5)", "Above Avg\n(10.5–15.25)", "Most\nWalkable\n(15.25–20)"),
include.lowest = TRUE
))
# summarize by walkability bin (doing median instead of mean to help it not be skewed by places like NYC or rural areas)
summary_wage_walkability <- wage_walkability |>
group_by(WalkCat) |>
summarise(
Low  = median(E_LowWageWk, na.rm = TRUE),
Med  = median(E_MedWageWk, na.rm = TRUE),
High = median(E_HiWageWk,  na.rm = TRUE),
.groups = "drop"
) |>
pivot_longer(cols = c(Low, Med, High),
names_to = "WageGroup",
values_to = "MedianWorkers") |>
mutate(WageGroup = factor(WageGroup, levels = c("Low", "Med", "High")))
wage_walkability_plot <- summary_wage_walkability |>
ggplot(aes(x = WalkCat, y = MedianWorkers, fill = WageGroup)) +
geom_col(position = position_dodge(width = 0.75), width = 0.65, alpha = 0.92) +
labs(title    = "Worker Wage Concentration by Neighborhood Walkability",
subtitle = "Median number of workers per census block group across walkability quartiles") +
theme_minimal(base_size = 13) +
theme(text = element_text(family = "Quicksand")) #make font macth the dashboard
wage_walkability_plot
wage_walkability_plot <- summary_wage_walkability |>
ggplot(aes(x = WalkCat, y = MedianWorkers, fill = WageGroup)) +
geom_col(position = position_dodge(width = 0.75), width = 0.65, alpha = 0.92) +
labs(title    = "Worker Wage Concentration by Neighborhood Walkability",
subtitle = "Median number of workers per census block group across walkability quartiles") +
theme(text = element_text(family = "Quicksand")) #make font macth the dashboard
wage_walkability_plot
wage_colors <- c("Low" = "#88CCEE", "Med" = "#DDCC77", "High" = "#CC6677") # color-blind friendly!
wage_walkability_plot <- summary_wage_walkability |>
ggplot(aes(x = WalkCat, y = MedianWorkers, fill = WageGroup)) +
scale_fill_manual(values = wage_colors,
labels = c("Low Wage", "Medium Wage", "High Wage"),
name = "Wage Group") +
geom_col(position = position_dodge(width = 0.75), width = 0.65, alpha = 0.92) +
labs(title    = "Worker Wage Concentration by Neighborhood Walkability",
subtitle = "Median number of workers per census block group across walkability quartiles",
x        = "National Walkability Index",
y        = "Median Number of Workers") +
theme_minimal(base_size = 12) +
theme(text = element_text(family = "Quicksand")) #make font macth the dashboard
wage_walkability_plot
wage_colors <- c("Low" = "#88CCEE", "Med" = "#DDCC77", "High" = "#CC6677") # color-blind friendly!
wage_walkability_plot <- summary_wage_walkability |>
ggplot(aes(x = WalkCat, y = MedianWorkers, fill = WageGroup)) +
scale_fill_manual(values = wage_colors,
labels = c("Low", "Medium", "High"),
name = "Wage Group") +
geom_col(position = position_dodge(width = 0.75), width = 0.65, alpha = 0.92) +
labs(title    = "Worker Wage Concentration by Neighborhood Walkability",
subtitle = "Median number of workers per census block group\nacross walkability quartiles",
x        = "National Walkability Index",
y        = "Median Number of Workers\n(per census block)") +
theme_minimal(base_size = 10) +
theme(text = element_text(family = "Quicksand")) #make font macth the dashboard
wage_walkability_plot
knitr::opts_chunk$set(echo = TRUE)
library(rio)
library(flexdashboard)
library(shiny)
