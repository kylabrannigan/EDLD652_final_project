library(rio)
library(tidyverse)
library(here)
crash <- import(here("FARS2019NationalCSV", "accident.csv")) #crash data
walkability <- import(here("Walkability.csv")) #cleaned walkability data
OR_walkability<- import(here("OR_walkability.csv")) #Oregon-specific walkability
city_walkability <- walkability %>% #walkability for each city
group_by(City) %>%
summarise(mean_walk = mean(NatWalkInd))
# Crash Data Filtering
crash <- crash %>%
select(STATENAME, RUR_URBNAME, HARM_EVNAME, FATALS)
View(OR_walkability)
# Walkability Data Cleaning
smart_location <- import(here("EPA_SmartLocationDatabase_V3_Jan_2021_Final.csv")) #smart location database and walkability index.
walkability <- smart_location %>%
select(GEOID10, CBSA, CBSA_Name, CBSA_POP, CBSA_EMP, CBSA_WRK, # select col of interest
TotPop, AutoOwn0, AutoOwn1, AutoOwn2p,
NatWalkInd,
TotEmp, E5_Ret, E5_Off, E5_Ind, E5_Svc, E5_Ent,
E_LowWageWk, E_MedWageWk, E_HiWageWk)
OR_walkability <- walkability |>
filter(str_detect(CBSA_Name, " OR")) |>
arrange(CBSA_Name)
write.csv(OR_walkability, "OR_walkability.csv")
